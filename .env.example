# ==============================================================================
# Weaverel Apparel — Environment Configuration Template (.env.example)
# ==============================================================================

# Security
SECRET_KEY=replace-with-a-very-long-random-secret-key-for-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,weaverel.com,www.weaverel.com

# Database (Leave DB_ENGINE=sqlite for local development)
DB_ENGINE=sqlite
# Or for PostgreSQL in production:
# DB_ENGINE=postgresql
# DATABASE_URL=postgres://weaverel_user:password@localhost:5432/weaverel_db
# DB_NAME=weaverel_db
# DB_USER=weaverel_user
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432
# Production SSL & HTTPS Settings
SECURE_SSL_REDIRECT=False

# Google OAuth2 Credentials (Optional for live Google Sign-In)
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email / SMS Gateway (Optional real providers)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=support@weaverel.com
# EMAIL_HOST_PASSWORD=app_password
